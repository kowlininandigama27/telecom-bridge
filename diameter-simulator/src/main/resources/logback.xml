<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} %-5level [%thread] %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="io.netty" level="WARN"/>
    <root level="${SIM_LOG_LEVEL:-INFO}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
